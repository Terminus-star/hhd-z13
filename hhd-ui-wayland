#!/bin/sh
# hhd-ui-wayland — run hhd's Electron UI natively on Wayland instead of XWayland.
#
# THE PROBLEM
#   /usr/bin/hhd-ui is just:
#       exec electron --no-sandbox /usr/lib/hhd-ui/app.asar $@
#   with no Ozone hints, so it lands on XWayland and is blurry on a
#   fractional-scaled panel.
#
# WHY SETTING THE ENV IN hhd's SERVICE DOES NOT WORK
#   hhd does not pass its environment through. plugins/overlay/overlay.py:
#       launch_overlay_de(...) -> subprocess.Popen([fn], env={
#           "HOME": ..., "XAUTHORITY": auth or "", "DISPLAY": display,
#           "HHD_MANAGED": "1" })
#   It builds a MINIMAL env from scratch — no WAYLAND_DISPLAY, no
#   XDG_RUNTIME_DIR — and hands Electron an X11 DISPLAY. So an Ozone hint set
#   anywhere upstream never arrives, and even when set here Electron cannot
#   find a compositor to connect to.
#
#   Therefore this wrapper reconstructs what it needs itself. hhd runs it as the
#   target user, so the uid is correct for locating the runtime dir.
#
# SAFE FALLBACK
#   If no Wayland socket is found we do NOT force Wayland; Electron keeps using
#   the DISPLAY hhd supplied. Worst case is the previous blurry-but-working UI,
#   never a UI that fails to start.
# APP-ID / KWIN RULE
#   The KWin rule for this window matches wmclass=dev.hhd.hhd-ui. On X11 that
#   is WM_CLASS, which Electron sets from the package name. On WAYLAND KWin
#   matches app-id instead, and hhd-ui.desktop has no StartupWMClass, so
#   Electron advertises something else and the rule stops matching -- the
#   window then appears in the taskbar, loses always-on-top, borderless and
#   centred placement. --class sets the Wayland app_id explicitly so the
#   existing rule keeps working.
set -u

: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR

# Locate a wayland socket if hhd did not give us one (it never does).
# hhd also strips DBUS_SESSION_BUS_ADDRESS, so Electron cannot reach the
# session bus and spends startup retrying/timing out on it -- visible as
# repeated "dbus/bus.cc:405 Failed to connect" and a noticeably slower open
# than the XWayland path. Point it at the user's bus socket.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    export DBUS_SESSION_BUS_ADDRESS
fi

if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -d "$XDG_RUNTIME_DIR" ]; then
    for _s in "$XDG_RUNTIME_DIR"/wayland-*; do
        case "$_s" in *.lock) continue ;; esac
        if [ -S "$_s" ]; then
            WAYLAND_DISPLAY="${_s##*/}"
            break
        fi
    done
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
    export WAYLAND_DISPLAY
    export ELECTRON_OZONE_PLATFORM_HINT=wayland
    # NOTE: deliberately NOT passing WaylandWindowDecorations. That enables
    # CLIENT-side decorations, i.e. Electron draws its own titlebar, which
    # KWin's noborder rule cannot remove. Without it Electron uses server-side
    # decorations and the KWin rule governs the frame.
    #
    # --ozone-platform=wayland alone is enough on current Electron; the extra
    # UseOzonePlatform feature flag is legacy and only adds startup work.
    exec electron --no-sandbox \
         --ozone-platform=wayland \
         --class=dev.hhd.hhd-ui \
         /usr/lib/hhd-ui/app.asar "$@"
fi

# No compositor reachable — behave exactly like stock hhd-ui.
exec electron --no-sandbox --class=dev.hhd.hhd-ui /usr/lib/hhd-ui/app.asar "$@"
