# Snapshot of the KWin rule this patch set relies on.
# ~/.config/kwinrulesrc is not itself in a repo, so the relevant rule is
# recorded here. Unrelated personal rules have been stripped.
#
# Merge this into ~/.config/kwinrulesrc, adding the UUID to [General] rules=
# and incrementing count=, then: qdbus org.kde.KWin /KWin reconfigure

[a45b89cb-15df-465c-ba4b-d1e537b19ba8]
Description=Handheld Daemon overlay behaviour
clientmachine=localhost
decocolor=
skippagerrule=3
skipswitcherrule=3
skippager=true
skipswitcher=true
types=1
wmclass=dev[.-]hhd[.-]hhd-ui
wmclassmatch=3

[General]
count=1
rules=a45b89cb-15df-465c-ba4b-d1e537b19ba8
